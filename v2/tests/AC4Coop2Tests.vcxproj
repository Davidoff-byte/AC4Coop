<?xml version="1.0" encoding="utf-8"?>
<!-- Offline unit tests for v2's pure code (net codec, reliable channel, registry, clock). From the repo root:
       MSBuild v2\tests\AC4Coop2Tests.vcxproj /nologo /v:m /p:Configuration=Release /p:Platform=Win32
       bin\v2\tests\AC4Coop2Tests.exe            (exit code = failed checks) -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6E0B2C1A-6F3E-4B8B-9C2E-AC4C0002F001}</ProjectGuid>
    <RootNamespace>AC4Coop2Tests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>NotSet</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\..\bin\v2\tests\</OutDir>
    <IntDir>$(ProjectDir)..\..\obj\v2\tests\</IntDir>
    <TargetName>AC4Coop2Tests</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <ExceptionHandling>Sync</ExceptionHandling>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ObjectFileName>$(IntDir)%(RelativeDir)</ObjectFileName>
      <PreprocessorDefinitions>WIN32;NDEBUG;_CONSOLE;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="test_main.cpp" />
    <ClCompile Include="test_codec.cpp" />
    <ClCompile Include="test_reliable.cpp" />
    <ClCompile Include="test_registry.cpp" />
    <ClCompile Include="test_spsc.cpp" />
    <ClCompile Include="test_interp.cpp" />
    <ClCompile Include="..\net\codec.cpp" />
    <ClCompile Include="..\net\reliable.cpp" />
    <ClCompile Include="..\net\registry.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
